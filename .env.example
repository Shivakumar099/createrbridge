# ============================================================
# CREATORBRIDGE PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ============================================================

# Application Environment
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-domain.com

# Cryptographic Session Encryption
SESSION_SECRET=your_32_character_cryptographically_secure_session_secret

# Persistent External Database (Optional: MongoDB Atlas or PostgreSQL)
# Leave blank to use atomic local persistent storage engine
DATABASE_URL=
MONGODB_URI=

# Payment Gateway (Razorpay India)
# Required for live payment processing and creator membership checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Script Writing Engine (Google Gemini API)
# Used for intelligent brief-to-script generation
GEMINI_API_KEY=
